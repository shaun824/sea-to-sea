{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/the-journey-3",
      "destination": "/the-journey/",
      "permanent": true
    },
    {
      "source": "/the-journey-3/",
      "destination": "/the-journey/",
      "permanent": true
    },
    {
      "source": "/the-journey-2",
      "destination": "/the-journey/",
      "permanent": true
    },
    {
      "source": "/the-journey-2/",
      "destination": "/the-journey/",
      "permanent": true
    },
    {
      "source": "/enter-here-2",
      "destination": "/enter-here/",
      "permanent": true
    },
    {
      "source": "/enter-here-2/",
      "destination": "/enter-here/",
      "permanent": true
    },
    {
      "source": "/enter-here-2-2",
      "destination": "/enter-here/",
      "permanent": true
    },
    {
      "source": "/enter-here-2-2/",
      "destination": "/enter-here/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sample-page",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sample-page/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/author/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/author/:slug*/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/:slug*/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": false
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap-index.xml",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}