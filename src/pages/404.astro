---
import Base from '../layouts/Base.astro';
---
<Base title="Wrong turn" noindex>
  <section class="section" style="padding-top: 160px; min-height: 70vh">
    <div class="wrap stack">
      <h1 class="display-xl">Wrong turn</h1>
      <p class="lead">This track doesn’t go anywhere. Happens to the best navigators.</p>
      <div class="btn-row"><a class="s2s-btn s2s-btn--primary" href="/">Back to the start</a><a class="s2s-btn s2s-btn--ghost" href="/the-journey/">See the route</a></div>
    </div>
  </section>
</Base>
