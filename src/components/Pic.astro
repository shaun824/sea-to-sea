---
// Responsive photo from /public/img: name-800.webp and name-1600.webp
interface Props { name: string; alt: string; sizes?: string; eager?: boolean; class?: string; small?: boolean }
const { name, alt, sizes = '100vw', eager = false, class: cls, small = false } = Astro.props;
const srcset = small ? `/img/${name}-800.webp 800w` : `/img/${name}-800.webp 800w, /img/${name}-1600.webp 1600w`;
---
<img class={cls} src={`/img/${name}-800.webp`} srcset={srcset} sizes={sizes} alt={alt}
  loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" width="1600" height="900" />
